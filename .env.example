# Copy to .env and fill in. .env is git-ignored.
#
# The agent works without any of this: with an empty LLM_API_KEY it stays on the
# deterministic rule planner. Fill in a key to let the model choose the diagnosis,
# strategy angles and price-point indices, then write the copy.

# ---------------------------------------------------------------------------
# Model provider: deepseek | qwen | glm | moonshot | minimax | openai | ollama
# ---------------------------------------------------------------------------
LLM_PROVIDER=deepseek

# Your key. Never hardcode it in Python.
LLM_API_KEY=

# Leave LLM_MODEL empty to use the provider default (see table below).
LLM_MODEL=

# Leave LLM_BASE_URL empty to use the provider default.
LLM_BASE_URL=

# Provider presets (used when MODEL / BASE_URL are empty):
#   deepseek  https://api.deepseek.com/v1                          deepseek-chat
#   qwen      https://dashscope.aliyuncs.com/compatible-mode/v1    qwen-plus
#   glm       https://open.bigmodel.cn/api/paas/v4                 glm-4-plus
#   moonshot  https://api.moonshot.cn/v1                           moonshot-v1-8k
#   minimax   https://api.minimaxi.com/v1                          MiniMax-M2.7-highspeed
#   openai    https://api.openai.com/v1                            gpt-4o-mini
#   ollama    http://127.0.0.1:11434/v1                            qwen2.5:14b   (no key needed)

# ---------------------------------------------------------------------------
# Guard rails. These are hard ceilings, not suggestions.
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096
LLM_MAX_CALLS_PER_ITEM=6
LLM_MAX_REVISION_ROUNDS=2
LLM_TIMEOUT=120

# ---------------------------------------------------------------------------
# Trade site (usually already exported in your user environment)
# ---------------------------------------------------------------------------
# SITE_AGENT_TOKEN=
# SITE_AGENT_BASE_URL=http://localhost:3000/api/agent
